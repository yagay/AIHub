<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.yagay.aihub">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Browser capability declarations. Chromium/WebEngine still owns the website permission
         prompt/decision flow; AIHub never grants these silently. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AIHubTheme">

        <activity
            android:name="com.yagay.aihub.chromium.AiHubShellActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.yagay.aihub.chromium.AiHubEntryActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aihub" />
            </intent-filter>

            <intent-filter>
                <action android:name="com.yagay.aihub.action.SWITCH" />
                <action android:name="com.yagay.aihub.action.SEND_TEXT" />
                <action android:name="com.yagay.aihub.action.NEW_CHAT" />
                <action android:name="com.yagay.aihub.action.STOP" />
                <action android:name="com.yagay.aihub.action.ATTACH" />
                <action android:name="com.yagay.aihub.action.BACK" />
                <action android:name="com.yagay.aihub.action.FORWARD" />
                <action android:name="com.yagay.aihub.action.RELOAD" />
                <action android:name="com.yagay.aihub.action.NEXT_PROVIDER" />
                <action android:name="com.yagay.aihub.action.PREVIOUS_PROVIDER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name="com.yagay.aihub.chromium.AiHubBinderService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.yagay.aihub.action.BIND" />
            </intent-filter>
        </service>
    </application>
</manifest>
