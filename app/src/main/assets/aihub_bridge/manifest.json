{
  "manifest_version": 2,
  "name": "AIHub Bridge",
  "version": "2.0",
  "description": "Bridges supported AI web pages to AIHub native controls.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@aihub.local"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://*.grok.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
