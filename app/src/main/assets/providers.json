[
  {
    "id": "chatgpt",
    "model": "chatgpt-web",
    "name": "ChatGPT",
    "homeUrl": "https://chatgpt.com/",
    "hosts": ["chatgpt.com"],
    "selectors": {
      "input": ["#prompt-textarea", "div#prompt-textarea[contenteditable='true']", "textarea[name='prompt-textarea']"],
      "send": ["button[data-testid='send-button']", "button[aria-label*='Send']"],
      "stop": ["button[data-testid='stop-button']", "button[aria-label*='Stop']"],
      "assistant": ["[data-message-author-role='assistant']", "article[data-turn='assistant'] .markdown", "article[data-turn='assistant']"]
    }
  },
  {
    "id": "claude",
    "model": "claude-web",
    "name": "Claude",
    "homeUrl": "https://claude.ai/new",
    "hosts": ["claude.ai"],
    "selectors": {
      "input": ["[data-testid='chat-input']", ".ProseMirror[contenteditable='true']", "div[contenteditable='true'][role='textbox']"],
      "send": ["button[aria-label='Send Message']", "button[aria-label*='Send']", "button[data-testid='send-button']"],
      "stop": ["button[aria-label='Stop Response']", "button[aria-label*='Stop']"],
      "assistant": ["div[data-testid*='assistant']", "div.font-claude-response-body", ".font-claude-response-body", "main .prose"]
    }
  },
  {
    "id": "gemini",
    "model": "gemini-web",
    "name": "Gemini",
    "homeUrl": "https://gemini.google.com/app",
    "hosts": ["gemini.google.com"],
    "selectors": {
      "input": ["div.ql-editor", "rich-textarea [contenteditable='true']", "[aria-label='Enter a prompt here']", "[contenteditable='true'][role='textbox']"],
      "send": ["button[aria-label='Send message']", "button[aria-label*='Send']", ".send-button", "button.send-button"],
      "stop": ["button[aria-label*='Stop']"],
      "assistant": ["model-response", "message-content", ".model-response-text", ".response-content"]
    }
  },
  {
    "id": "deepseek",
    "model": "deepseek-web",
    "name": "DeepSeek",
    "homeUrl": "https://chat.deepseek.com/",
    "hosts": ["chat.deepseek.com"],
    "selectors": {
      "input": ["textarea[placeholder*='DeepSeek']", "textarea", "div[contenteditable='true'][role='textbox']"],
      "send": ["button[aria-label*='Send']", "button[type='submit']", "div[role='button'][aria-label*='Send']"],
      "stop": ["button[aria-label*='Stop']", "div[role='button'][aria-label*='Stop']"],
      "assistant": [".ds-markdown", "[class*='ds-markdown']", "[data-role='assistant']", "main .markdown"]
    }
  },
  {
    "id": "grok",
    "model": "grok-web",
    "name": "Grok",
    "homeUrl": "https://grok.com/",
    "hosts": ["grok.com"],
    "selectors": {
      "input": ["[data-testid='chat-input']", "div.ProseMirror[role='textbox']", "div.ProseMirror[contenteditable='true']", "textarea", "div[contenteditable='true'][role='textbox']"],
      "send": ["button[aria-label*='Send']", "button[type='submit']"],
      "stop": ["button[aria-label*='Stop']"],
      "assistant": ["[data-testid*='assistant']", "[data-message-author-role='assistant']", "div[class*='message-bubble'] .prose", "main .prose"]
    }
  }
]
