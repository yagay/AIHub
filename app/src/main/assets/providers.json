[
  {
    "id": "chatgpt",
    "name": "ChatGPT",
    "homeUrl": "https://chatgpt.com/",
    "hosts": ["chatgpt.com"],
    "selectors": {
      "input": ["#prompt-textarea", "div#prompt-textarea[contenteditable='true']", "textarea"],
      "send": ["button[data-testid='send-button']", "button[aria-label*='Send']"],
      "newChat": ["a[href='/']", "button[aria-label*='New chat']"],
      "stop": ["button[data-testid='stop-button']", "button[aria-label*='Stop']"],
      "attach": ["input[type='file']", "button[aria-label*='Attach']", "button[aria-label*='Upload']"]
    },
    "ui": {
      "hide": ["header", "[role='banner']"],
      "actions": [
        {"id":"history","label":"History","selectors":["button[data-testid='open-sidebar-button']","button[aria-label*='sidebar']","button[aria-label*='History']"],"keywords":["sidebar","history"]},
        {"id":"model","label":"Model","selectors":["button[data-testid='model-switcher-dropdown-button']","button[aria-label*='model']"],"keywords":["model","gpt"]},
        {"id":"copy","label":"Copy","pick":"last","selectors":["button[aria-label*='Copy']","button[data-testid*='copy']"],"keywords":["copy"]},
        {"id":"retry","label":"Regenerate","pick":"last","selectors":["button[aria-label*='Regenerate']","button[aria-label*='Retry']","button[data-testid*='regenerate']"],"keywords":["regenerate","retry","try again"]},
        {"id":"account","label":"Account","selectors":["button[data-testid='profile-button']","button[aria-label*='profile']","button[aria-label*='account']"],"keywords":["profile","account"]},
        {"id":"more","label":"More","selectors":["button[aria-label='More']","button[aria-label*='More']"],"keywords":["more"]}
      ]
    }
  },
