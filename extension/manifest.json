{
  "manifest_version": 3,
  "name": "AIHub Titanium Bridge",
  "version": "2.1.4",
  "description": "Connects AIHub to logged-in AI websites in Titanium Browser without provider API keys.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:3847/*",
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://claude.ai/*",
    "*://gemini.google.com/*",
    "*://chat.deepseek.com/*",
    "*://grok.com/*",
    "*://www.grok.com/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://chat.deepseek.com/*",
        "*://grok.com/*",
        "*://www.grok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}